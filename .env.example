# Rule analysis works without any of these AI settings.
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=45

# Optional. If blank, a random admin password is generated in data/android-doctor.admin-password.
APP_ADMIN_PASSWORD=
APP_ADMIN_SESSION_HOURS=8

# Optional production override. Separate multiple origins with commas.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9090

